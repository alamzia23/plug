---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo {...props} />
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
