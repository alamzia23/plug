# plug — configuration reference.
#
# Nothing here is read at runtime. This project has no server and no build
# step: the real values live in Apps Script's Script Properties, which is the
# only place they exist. This file documents what you need to set and what
# each one does.
#
# Apps Script editor -> Project Settings (gear icon) -> Script Properties.

# --- required ---------------------------------------------------------------

# Shared secret between the extension and the web app. setUp() generates it;
# read it from Script Properties, never from a log. rotateToken() replaces it.
PLUG_TOKEN=generated-by-setUp

# The Google Sheet that setUp() creates and uses as the database.
SHEET_ID=generated-by-setUp

# --- the model that writes the drafts ---------------------------------------

# gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_API_KEY=your-provider-key
# Optional. Each provider has a sensible default.
LLM_MODEL=

# --- finding and checking work addresses (optional) -------------------------

# hunter | abstract | mailboxlayer
# Only hunter can also find people at a company; the others verify only.
# Hunter refuses free email addresses at signup; abstract and mailboxlayer don't.
VERIFIER=
VERIFIER_API_KEY=

# --- in the Sheet's `settings` tab, not Script Properties -------------------
# DRY_RUN=true              every email goes to TEST_INBOX instead of the real person
# TEST_INBOX=              where dry-run mail lands; defaults to your own address
# DAILY_CAP=25             max sends per day, counting dry runs
# MAX_CONTACTS_PER_JOB=3   three asks at one company is the limit
# MAX_FOLLOWUPS=2          after the first email
# DIRECTORY_LIMIT=10       people fetched per lookup; hunter bills per address
